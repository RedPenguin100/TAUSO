+  // Each log_dot sums n terms in log space. Folding a term in with LOGADD costs
+  // one exp AND one log1p; taking the maximum first and summing exp(term - max)
+  // costs one exp per term and a single log for the whole reduction. The exp
+  // loop carries no dependency, so it also vectorises.
+  enum { LOG_DOT_BUF = 512};
+  template <typename T> void log_dot_fold(T& t, IntT n, const ScoreT* v) {
+    ScoreT m = NEG_INF();
+    for (IntT k = 0; k < n; ++k) { if (v[k] > m) { m = v[k];}}
+    if (impossible(m)) return;
+    ScoreT s = 0.0;
+    for (IntT k = 0; k < n; ++k) { s += std::exp(v[k] - m);}
+    LOGADD(t, (m + std::log(s)));
+  }
+  template <typename T, typename Iter> void log_dot_pm(T& t, IntT n, Iter i1, Iter i2) {
+    if (n > LOG_DOT_BUF) { while (n-- > 0) { LOGADD(t, (*i1++) + (*i2--));} return;}
+    ScoreT v[LOG_DOT_BUF];
+    for (IntT k = 0; k < n; ++k) { v[k] = (*i1++) + (*i2--);}
+    log_dot_fold(t, n, v);
+  }
+  template <typename T, typename Iter> void log_dot_pp(T& t, IntT n, Iter i1, Iter i2) {
+    if (n > LOG_DOT_BUF) { while (n-- > 0) { LOGADD(t, (*i1++) + (*i2++));} return;}
+    ScoreT v[LOG_DOT_BUF];
+    for (IntT k = 0; k < n; ++k) { v[k] = (*i1++) + (*i2++);}
+    log_dot_fold(t, n, v);
+  }
+  template <typename T, typename Iter> void log_dot_mp(T& t, IntT n, Iter i1, Iter i2) {
+    if (n > LOG_DOT_BUF) { while (n-- > 0) { LOGADD(t, (*i1--) + (*i2++));} return;}
+    ScoreT v[LOG_DOT_BUF];
