+// softplus(-d) = log1p(exp(-d)) for d >= 0, tabulated on [0, CUT] with quadratic
+// interpolation. Replaces the libm log1p+exp pair that dominates logadd.
+struct SoftplusTable {
+  enum {N = 65536, CUT = 40};
+  double v[N + 3];
+  double inv_step, step;
+  SoftplusTable() {
+    step = double(CUT) / N;
+    inv_step = 1.0 / step;
+    for (int i = 0; i <= N + 2; ++i) { v[i] = ::log1p(std::exp(-(i * step)));}
+  }
+  inline double operator()(double d) const {
+    if (d >= CUT) return 0.0;
+    const double x = d * inv_step;
+    const int    i = int(x);
+    const double f = x - i;
+    const double a = v[i], b = v[i + 1], c = v[i + 2];
+    // Newton form through (0,a),(1,b),(2,c) evaluated at f.
+    const double d1 = b - a, d2 = c - b;
+    return a + f * (d1 + 0.5 * (f - 1.0) * (d2 - d1));
+  }
+};
